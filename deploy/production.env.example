# Remote.Command 生产环境 Docker Compose 环境变量模板（脱敏）
# 使用方法：
#   cp deploy/production.env.example .env && chmod 600 .env
# 注意：不要将填写了真实凭证的 .env 提交到 Git

PUBLIC_ORIGIN=https://mcp.example.com

# Google Cloud Console -> Google Auth Platform -> Clients (Web application) 获取
# Authorized redirect URI 必须精确填写为: https://mcp.example.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 强烈建议填写首个管理员的 Google 邮箱（多个用英文逗号分隔）
ADMIN_GOOGLE_EMAILS=owner@example.com

# 部署在宿主机 Nginx 等反向代理后时建议开启，用于限流识别真实客户端 IP
TRUST_PROXY=1

# 可选：数据保留策略（天）
# RCM_TASK_RETENTION_DAYS=7
# RCM_AUDIT_RETENTION_DAYS=90
# RCM_DCR_CLIENT_TTL_DAYS=30
# RCM_RESULT_TTL_MINUTES=30

# 可选：HTTP Long Polling、同步等待与多租户背压控制（毫秒 / 数量）
# RCM_LONG_POLL_MS=25000
# RCM_SYNC_WAIT_MS=15000
# RCM_MAX_USER_ACTIVE=8
# RCM_MAX_USER_WAITING=128
# RCM_TASK_LEASE_MS=360000
