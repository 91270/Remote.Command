{
  "name": "remote-command",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "gateway": "node dist/gateway.js",
    "agent": "node dist/agent.js",
    "admin": "node dist/admin.js",
    "backup": "node scripts/backup.mjs",
    "remote": "node dist/remote-cli.js remote",
    "package:client": "npm run build && node scripts/package-client.mjs",
    "package:release": "npm run build && node scripts/package-release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.4.3",
    "cross-fetch": "4.1.0",
    "proper-lockfile": "4.1.2",
    "fastest-levenshtein": "1.0.16",
    "isbinaryfile": "5.0.4",
    "unbash": "6.0.1",
    "zod3": "npm:zod@3.25.76",
    "zod-to-json-schema": "3.25.2",
    "exceljs": "4.4.0",
    "pizzip": "3.2.0",
    "pdf-lib": "1.17.1",
    "md-to-pdf": "5.2.5",
    "@opendocsg/pdf2md": "0.3.4",
    "unpdf": "1.8.1",
    "sharp": "0.35.5",
    "@vscode/ripgrep": "1.18.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.8.3"
  },
  "bin": {
    "remote-command": "dist/remote-cli.js"
  }
}
