# Remote.Command 本地开发/测试环境变量模板（脱敏）
# 使用方法：
#   install -d -m 0700 state
#   cp local-test.env.example state/local-test.env && chmod 600 state/local-test.env
# 注意：state/ 目录已被 .gitignore 忽略，切勿把填写了真实密钥的配置提交到 Git

PUBLIC_ORIGIN="https://dev-mcp.example.com"
BIND_HOST="127.0.0.1"
PORT="8787"
TRUST_PROXY="1"
STATE_DB="./state/local-test.sqlite"

# Google Cloud Console -> Google Auth Platform -> Clients (Web application) 获取
# Authorized redirect URI 必须精确填写为: ${PUBLIC_ORIGIN}/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 强烈建议填写你自己的 Google 邮箱（多个用英文逗号分隔），锁定首个管理员注册权限
ADMIN_GOOGLE_EMAILS="owner@example.com"

# Cloudflare Zero Trust Dashboard -> Networks -> Tunnels 获取的 Tunnel Token
CLOUDFLARED_TUNNEL_TOKEN=""

# 若本机代理 / TUN Fake-IP 导致 cloudflared 默认 QUIC (UDP 7844) 握手报 TLS EOF，可取消注释改走 HTTP/2 (TCP)
# TUNNEL_TRANSPORT_PROTOCOL="http2"

# 若本机访问 accounts.google.com 需要 HTTP 代理，取消以下两行注释并填写真实代理端口
# NODE_USE_ENV_PROXY="1"
# HTTPS_PROXY="http://127.0.0.1:7890"
